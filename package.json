{
  "name": "chandao4",
  "version": "0.2.3",
  "description": "禅道命令行工具 - Bug、任务、项目和产品管理，支持企业版 4.1.3+",
  "main": "dist/index.js",
  "bin": {
    "chandao4": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "test": "node --require tsx/cjs --test tests/actions.test.cjs tests/file.test.cjs",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "src/skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    ".env.example"
  ],
  "keywords": [
    "chandao",
    "chandao4",
    "zentao",
    "禅道",
    "cli",
    "bug",
    "task",
    "project",
    "product",
    "项目管理",
    "研发管理"
  ],
  "author": "gaoshang212",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gaoshang212/chandao4.git"
  },
  "homepage": "https://github.com/gaoshang212/chandao4#readme",
  "bugs": {
    "url": "https://github.com/gaoshang212/chandao4/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "ora": "^9.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
